{
	"$schema": "https://v2-9-7.turborepo.dev/schema.json",
	"concurrency": "30",
	"globalDependencies": ["**/.dev.vars"],
	"globalEnv": [
		"CI",
		"CLOUDFLARE_ACCOUNT_ID",
		"DB_MIGRATE_VERBOSE",
		"DISCORD_CLIENT_ID",
		"DISCORD_BOT_TOKEN",
		"DISCORD_PUBLIC_KEY",
		"ENCRYPTION_KEY",
		"ENVIRONMENT",
		"EVE_SSO_CALLBACK_URL",
		"EVE_SSO_CLIENT_ID",
		"EVE_SSO_CLIENT_SECRET",
		"GITHUB_ACTIONS",
		"VITEST",
		"XDG_CONFIG_HOME",
		"DEV",
		"NODE_OPTIONS",
		"LOCAL_DEV_INCLUDE_WORKERS",
		"LOCAL_DEV_EXCLUDE_WORKERS",
		"LOCAL_DEV_DISABLE_AUXILIARY_WORKERS",
		"LOCAL_DEV_ALLOWED_HOSTS",
		"SDE_DATA_DIR",
		"VITE_DISCORD_CLIENT_ID",
		"DATABASE_URL",
		"DATABASE_URL_MIGRATIONS",
		"IP_ADDRESS_HASH_SECRET",
		"LEGACY_DATABASE_URL",
		"LEGACY_IMPORT_ACTOR_USER_ID",
		"LOG_LEVEL",
		"PROD",
		"EDITOR",
		"NEON_AUTH_NG_PROJECT_ID",
		"NEON_AUTH_NG_ORG_ID",
		"LEGACY_BLACKLIST_LEVELS",
		"NEON_API_KEY",
		"NEON_PROJECT_ID",
		"NEON_TEST_PARENT_BRANCH_ID",
		"TEST_DATABASE_URL",
		"OAUTH_ISSUER",
		"OAUTH_CLIENT_ID",
		"OAUTH_CLIENT_SECRET",
		"OAUTH_CLIENT_AUTH_METHOD",
		"OAUTH_REDIRECT_URI",
		"OAUTH_HARNESS_JSON",
		"OAUTH_HARNESS_DEBUG",
		"SESSION_SECRET",
		"SENTRY_DSN",
		"SENTRY_RELEASE",
		"SRP_PUBLIC_API_TOKEN",
		"VITE_API_BASE_URL"
	],
	"globalPassThroughEnv": ["WRANGLER_LOG", "FORCE_COLOR"],
	"remoteCache": {
		// Enable if using Turbo Remote Cache
		"enabled": false,
		"signature": true
	},
	"ui": "tui",
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build", "topo"],
			"outputs": ["dist/**", ".wrangler/deploy/config.json"],
			"outputLogs": "new-only"
		},
		"dev": {
			"cache": false,
			"dependsOn": ["build", "topo"],
			"interactive": true,
			"persistent": true,
			"outputLogs": "new-only"
		},
		// preview is used in Vite applications
		"preview": {
			"cache": false,
			"dependsOn": ["build", "topo"],
			"interactive": true,
			"persistent": true,
			"outputLogs": "new-only"
		},
		// tail is used to stream worker logs with auto-reconnect
		"tail": {
			"cache": false,
			"interactive": true,
			"persistent": true,
			"outputLogs": "new-only"
		},
		"deploy": {
			"cache": false,
			"dependsOn": ["build", "topo"],
			"env": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"],
			"outputLogs": "new-only"
		},
		"eve-corporation-data#deploy": {
			"cache": false,
			"dependsOn": ["build", "topo", "corporation-tax#deploy"],
			"env": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"],
			"outputLogs": "new-only"
		},
		"core#deploy": {
			"cache": false,
			"dependsOn": ["build", "topo", "moon-scan#deploy"],
			"env": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"],
			"outputLogs": "new-only"
		},
		// build:wrangler isn't used much, but can be useful for debugging
		"build:wrangler": {
			"dependsOn": ["build", "topo"],
			"outputLogs": "new-only"
		},
		"check": {
			"dependsOn": ["check:types", "check:lint", "topo"],
			"outputLogs": "new-only"
		},
		"//#test:ci": {
			"dependsOn": [
				"build"
				// Packages that need to be built before running tests can be added here.
				// Example:
				// "@repo/test-helpers#build"
			],
			"outputLogs": "new-only"
		},
		"test:ci": {
			"dependsOn": ["build", "topo"],
			"outputLogs": "new-only"
		},
		"test:focused": {
			"dependsOn": ["build", "topo"],
			"outputLogs": "new-only"
		},
		"check:ci": {
			"dependsOn": ["//#check:deps", "check:types", "topo"],
			"outputLogs": "new-only"
		},
		"//#check:deps": {
			"outputLogs": "new-only"
		},
		"check:types": {
			"dependsOn": ["build", "topo"],
			"outputLogs": "new-only"
		},
		"check:lint": {
			"dependsOn": ["build", "topo"],
			"outputLogs": "new-only",
			"env": ["FIX_ESLINT", "XDG_CONFIG_HOME"]
		},
		"//#check:lint:all": {
			"outputLogs": "new-only",
			"outputs": ["node_modules/.cache/.eslintcache"],
			"env": ["FIX_ESLINT"]
		},
		"//#check:format": {
			"dependsOn": [],
			"outputLogs": "new-only"
		},
		"fix:workers-types": {
			"outputs": ["worker-configuration.d.ts", "topo"],
			"outputLogs": "new-only"
		},
		"//#build": {
			"dependsOn": ["^build"],
			"outputLogs": "new-only"
		}
	}
}
