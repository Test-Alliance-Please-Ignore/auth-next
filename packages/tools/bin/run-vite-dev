#!/bin/sh
set -eu

# Find monorepo root and source .env if it exists
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/../../.." && pwd)
if [ -f "$REPO_ROOT/.env" ]; then
	set -a
	# shellcheck disable=SC1091
	. "$REPO_ROOT/.env"
	set +a
fi

# Expose the sourced root environment to the local Cloudflare Worker runtime. This is safe for
# local-only dev because all module .dev.vars files are intentionally absent.
export CLOUDFLARE_INCLUDE_PROCESS_ENV=true

exec vite dev
