#!/bin/sh
set -eu

# Find monorepo root and source .env if it exists
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/../../.." && pwd)
if [ -f "$REPO_ROOT/.env" ]; then
	set -a
	# shellcheck disable=SC1091
	. "$REPO_ROOT/.env"
	set +a
fi

NAME=$(jq -r '.name' package.json)

if [ ! -f "wrangler.local.jsonc" ]; then
	echo "Error: wrangler.local.jsonc not found in $(pwd)" >&2
	echo "Create wrangler.local.jsonc or use run-wrangler-dev for default config." >&2
	exit 1
fi

exec wrangler dev \
	--config wrangler.local.jsonc \
	--var NAME:"$NAME" \
	"$@"
