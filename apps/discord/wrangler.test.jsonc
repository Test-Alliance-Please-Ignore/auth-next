{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "discord",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"logpush": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"NAME": "discord",
		"ENVIRONMENT": "VITEST",
		"SENTRY_RELEASE": "unknown",
		"DISCORD_CLIENT_ID": "1428533721585418350",
		"DISCORD_AUTHORIZE_URL": "https://discord.com/oauth2/authorize",
		"DISCORD_TOKEN_URL": "https://discord.com/api/oauth2/token",
		"DISCORD_TOKEN_REVOKE_URL": "https://discord.com/api/oauth2/token/revoke",
		"DISCORD_USER_INFO_URL": "https://discord.com/api/users/@me",
		"DISCORD_CALLBACK_URL": "https://pleaseignore.app/api/discord/callback",
		"DISCORD_GATEWAY_ENABLED": "false",
		"DISCORD_ROLE_ADD_ONLY_MODE": "true"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DISCORD",
				"class_name": "Discord"
			},
			{
				"name": "DISCORD_GATEWAY",
				"class_name": "DiscordGateway"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Discord"]
		},
		{
			"tag": "v2",
			"new_classes": ["DiscordGateway"]
		}
	]
}
