{
	"name": "structures",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx ./src/scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest",
		"test:focused": "run-vitest --config vitest.node.config.ts",
		"test:unit": "run-vitest"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.0.2",
		"@repo/alert-destinations": "workspace:*",
		"@repo/core-db-schema": "workspace:*",
		"@repo/db-utils": "workspace:*",
		"@repo/discord": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/eve-corporation-data": "workspace:*",
		"@repo/eve-corporation-data-db-schema": "workspace:*",
		"@repo/eve-fitting": "workspace:*",
		"@repo/groups": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/inventory-display": "workspace:*",
		"@repo/structure-states": "workspace:*",
		"@repo/structures": "workspace:*",
		"@repo/structures-db-schema": "workspace:*",
		"@repo/universe": "workspace:*",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.27",
		"workers-tagged-logger": "0.13.7",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.47.0",
		"@cloudflare/vitest-pool-workers": "0.19.1",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.10.1",
		"dotenv": "17.2.3",
		"drizzle-kit": "0.31.10",
		"tsx": "4.21.0",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"wrangler": "4.116.0"
	}
}
