{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "doctrines",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"durable_objects": {
		"bindings": [
			{
				"name": "DOCTRINES",
				"class_name": "Doctrines"
			},
			{
				"name": "GROUPS",
				"class_name": "Groups",
				"script_name": "groups"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Doctrines"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["Doctrines"]
		}
	]
}
