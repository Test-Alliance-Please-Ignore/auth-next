{
	"name": "fulcrum",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx ./src/scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest",
		"test:unit": "run-vitest --config vitest.unit.config.ts"
	},
	"dependencies": {
		"@hono/zod-validator": "0.7.5",
		"@neondatabase/serverless": "1.0.2",
		"@repo/db-utils": "workspace:*",
		"@repo/discord": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/esi": "workspace:*",
		"@repo/fulcrum": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/hr": "workspace:*",
		"@repo/universe": "workspace:*",
		"@repo/worker-utils": "workspace:*",
		"@repo/workflow-utils": "workspace:*",
		"drizzle-orm": "0.44.7",
		"hono": "4.10.6",
		"preact": "10.27.2",
		"preact-render-to-string": "6.6.3",
		"workers-tagged-logger": "0.13.7",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.0",
		"@cloudflare/vitest-pool-workers": "0.10.8",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.10.1",
		"dotenv": "17.2.3",
		"drizzle-kit": "0.31.10",
		"tsx": "4.21.0",
		"vite": "7.2.2",
		"vitest": "3.2.4",
		"wrangler": "4.87.0"
	}
}
