{
	"name": "third-party-apps",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"oauth:harness": "tsx ./src/scripts/oauth-client-harness.ts",
		"oauth:scenario:esi": "tsx ./src/scripts/oauth-client-harness.ts scenario-esi-basic",
		"oauth:scenario:profile": "tsx ./src/scripts/oauth-client-harness.ts scenario-profile",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "0.0.10",
		"@neondatabase/serverless": "1.0.2",
		"@repo/admin": "workspace:*",
		"@repo/db-utils": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/esi": "workspace:*",
		"@repo/esi-rate-limit": "workspace:*",
		"@repo/groups": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/worker-utils": "workspace:*",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.27",
		"radix3": "1.1.1",
		"workers-tagged-logger": "0.13.7",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.47.0",
		"@cloudflare/vitest-pool-workers": "0.18.8",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"@types/node": "24.10.1",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"wrangler": "4.114.0"
	}
}
