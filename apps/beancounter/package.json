{
	"name": "beancounter",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"cli": "tsx ./scripts/cli/index.ts",
		"db:generate": "drizzle-kit generate --config drizzle-sqlite.config.ts && drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "tsx ./src/scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest",
		"vite": "vite",
		"wrangler": "wrangler"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.0.2",
		"@repo/beancounter": "workspace:*",
		"@repo/db-utils": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/esi": "workspace:*",
		"@repo/eve-corporation-data": "workspace:*",
		"@repo/eve-token-store": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/universe": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"cli-table3": "0.6.5",
		"commander": "14.0.2",
		"drizzle-orm": "0.44.7",
		"hono": "4.10.6",
		"workers-tagged-logger": "0.13.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.0",
		"@cloudflare/vitest-pool-workers": "0.10.8",
		"@commander-js/extra-typings": "14.0.0",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.10.1",
		"dotenv": "17.2.3",
		"drizzle-kit": "0.31.10",
		"tsx": "4.21.0",
		"vite": "7.2.2",
		"vitest": "3.2.4",
		"wrangler": "4.87.0"
	}
}
