{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beancounter",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"durable_objects": {
		"bindings": [
			{
				"name": "STRUCTURE_MONITOR",
				"class_name": "StructureMonitor"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Beancounter"]
		},
		{
			"tag": "v2",
			"renamed_classes": [
				{
					"from": "Beancounter",
					"to": "StructureMonitor"
				}
			]
		}
	]
}
