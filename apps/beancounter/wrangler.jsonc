{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beancounter",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"vars": {},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "STRUCTURE_MONITOR",
				"class_name": "StructureMonitor"
			},
			{
				"name": "STRUCTURE_COORDINATOR",
				"class_name": "StructureCoordinator"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Beancounter"]
		},
		{
			"tag": "v2",
			"renamed_classes": [
				{
					"from": "Beancounter",
					"to": "StructureMonitor"
				}
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["StructureCoordinator"]
		}
	]
}
