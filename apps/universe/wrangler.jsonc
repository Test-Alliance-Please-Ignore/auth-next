{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "universe",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "UNIVERSE_CACHE",
			"id": "3e1625439a444650a410b5ec877bf23c"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "UNIVERSE",
				"class_name": "Universe"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Universe"]
		}
	]
}
