{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "core",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"routes": [
		"pleaseignore.app/api/*",
		"pleaseignore.app/images/*",
		"pleaseignore.app/invite/*",
		"pleaseignore.app/login*",
		"pleaseignore.app/fleets/*"
	],
	"logpush": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"workers_dev": false,
	"triggers": {
		// Runs 3 minutes after the 5-minute corporation data refresh cron,
		// giving corp sync time to detect departures and enqueue pending refreshes.
		// A separate half-hour cron drains token invalidation DMs.
		// Also runs daily at midnight UTC for Discord member audit cleanup.
		"crons": ["3-58/5 * * * *", "15,45 * * * *", "0 0 * * *"]
	},
	"vars": {
		"NAME": "core",
		"ENVIRONMENT": "production",
		"SENTRY_RELEASE": "unknown",
		"SENTRY_DSN": "https://8a3d31a3a18e448f97e19e3d9930547d@app.glitchtip.com/13711",
		"LEGACY_AUTH_CALLBACK_URL": "https://pleaseignore.app/api/auth/legacy-auth/callback",
		"MUMBLE_SERVER_ID": "srv-1",
		"MUMBLE_HOST": "numumble.pleaseignore.com",
		"MUMBLE_PORT": "64737",
		// Prediction markets: guild + category the bot creates the markets forum channel under.
		// Replace with the real ids per environment; the bot needs MANAGE_CHANNELS + MANAGE_ROLES.
		"PM_FORUM_GUILD_ID": "356398105404375041",
		"PM_FORUM_CATEGORY_ID": "1524076742745260093"
	},
	"r2_buckets": [
		{
			"binding": "MOON_SCAN_EXPORTS",
			"bucket_name": "moon-scan-exports"
		},
		{
			"binding": "SRP_EXPORTS",
			"bucket_name": "srp-exports"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "GROUPS",
				"class_name": "Groups",
				"script_name": "groups"
			},
			{
				"name": "DISCORD",
				"class_name": "Discord",
				"script_name": "discord"
			},
			{
				"name": "BILLS",
				"class_name": "Bills",
				"script_name": "bills"
			},
			{
				"name": "PREDICTION_MARKETS",
				"class_name": "PredictionMarkets",
				"script_name": "prediction-markets"
			},
			{
				"name": "CORPORATION_TAX",
				"class_name": "CorporationTax",
				"script_name": "corporation-tax"
			},
			{
				"name": "BROADCASTS",
				"class_name": "Broadcasts",
				"script_name": "broadcasts"
			},
			{
				"name": "DOCTRINES",
				"class_name": "Doctrines",
				"script_name": "doctrines"
			},
			{
				"name": "FLEETS",
				"class_name": "Fleets",
				"script_name": "fleets"
			},
			{
				"name": "FREIGHT",
				"class_name": "Freight",
				"script_name": "freight"
			},
			{
				"name": "HR",
				"class_name": "Hr",
				"script_name": "hr"
			},
			{
				"name": "SKILLS",
				"class_name": "Skills",
				"script_name": "skills"
			},
			{
				"name": "SRP",
				"class_name": "Srp",
				"script_name": "srp"
			},
			{
				"name": "SRP_RECENT_LOSS_REFRESH_COORDINATOR",
				"class_name": "RecentLossRefreshCoordinatorDO",
				"script_name": "srp"
			},
			{
				"name": "FEATURES",
				"class_name": "Features",
				"script_name": "features"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "CORE",
				"class_name": "Core",
				"script_name": "core"
			},
			{
				"name": "INDUSTRY",
				"class_name": "Industry",
				"script_name": "industry"
			},
			{
				"name": "FULCRUM",
				"class_name": "Fulcrum",
				"script_name": "fulcrum"
			},
			{
				"name": "LEGACY",
				"class_name": "Legacy",
				"script_name": "legacy"
			},
			{
				"name": "MOON_SCAN",
				"class_name": "MoonScanDO",
				"script_name": "moon-scan"
			},
			{
				"name": "MARKETS",
				"class_name": "Markets",
				"script_name": "markets"
			},
			{
				"name": "MUMBLE",
				"class_name": "Mumble",
				"script_name": "mumble"
			}
		]
	},
	"services": [
		{
			"binding": "ADMIN",
			"service": "admin"
		},
		{
			"binding": "STRUCTURES",
			"service": "structures",
			"entrypoint": "StructuresWorkerEntrypoint"
		},
		{
			"binding": "THIRD_PARTY_APPS",
			"service": "third-party-apps",
			"entrypoint": "ThirdPartyAppsWorkerEntrypoint"
		},
		{
			"binding": "PASTE",
			"service": "paste",
			"entrypoint": "PasteWorkerEntrypoint"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Core"]
		}
	],
	"workflows": [
		{
			"name": "csv-export-workflow",
			"binding": "EXPORT_WORKFLOW",
			"class_name": "CsvExportWorkflow"
		},
		{
			"name": "user-refresh-workflow",
			"binding": "USER_REFRESH_WORKFLOW",
			"class_name": "UserRefreshWorkflow"
		},
		{
			"name": "user-discord-refresh-workflow",
			"binding": "USER_DISCORD_REFRESH_WORKFLOW",
			"class_name": "UserDiscordRefreshWorkflow"
		},
		{
			"name": "discord-member-audit-workflow",
			"binding": "DISCORD_MEMBER_AUDIT_WORKFLOW",
			"class_name": "DiscordMemberAuditWorkflow"
		},
		{
			"name": "user-mumble-refresh-workflow",
			"binding": "USER_MUMBLE_REFRESH_WORKFLOW",
			"class_name": "UserMumbleRefreshWorkflow"
		}
	]
}
