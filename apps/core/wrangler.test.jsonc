{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "core",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CORE",
				"class_name": "Core"
			},
			{
				"name": "TEMPORARY_ROLE_ASSIGNMENTS",
				"class_name": "TemporaryRoleAssignments"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Core"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["TemporaryRoleAssignments"]
		}
	]
}
