{
	"name": "core",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx ./src/scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"fix:workers-types": "run-wrangler-types",
		"migrate:directors": "bun run scripts/migrate-directors.ts",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest --config vitest.unit.config.ts",
		"test:unit": "run-vitest --config vitest.unit.config.ts",
		"test:workers": "run-vitest --config vitest.config.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.0.2",
		"@repo/admin": "workspace:*",
		"@repo/bills": "workspace:*",
		"@repo/broadcasts": "workspace:*",
		"@repo/core": "workspace:*",
		"@repo/corporation-tax": "workspace:*",
		"@repo/db-utils": "workspace:*",
		"@repo/discord": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/doctrines": "workspace:*",
		"@repo/esi": "workspace:*",
		"@repo/eve-character-data": "workspace:*",
		"@repo/eve-corporation-data": "workspace:*",
		"@repo/eve-token-store": "workspace:*",
		"@repo/eve-types": "workspace:*",
		"@repo/features": "workspace:*",
		"@repo/fleets": "workspace:*",
		"@repo/freight": "workspace:*",
		"@repo/fulcrum": "workspace:*",
		"@repo/groups": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/hr": "workspace:*",
		"@repo/industry": "workspace:*",
		"@repo/legacy": "workspace:*",
		"@repo/skills": "workspace:*",
		"@repo/srp": "workspace:*",
		"@repo/universe": "workspace:*",
		"@repo/workflow-utils": "workspace:*",
		"drizzle-orm": "0.44.7",
		"hono": "4.10.6",
		"workers-tagged-logger": "0.13.7",
		"zod": "4.1.12"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.0",
		"@cloudflare/vitest-pool-workers": "0.10.8",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"@types/node": "24.10.1",
		"dotenv": "17.2.3",
		"drizzle-kit": "0.31.10",
		"tsx": "4.21.0",
		"vite": "7.2.2",
		"vitest": "3.2.4",
		"wrangler": "4.87.0"
	}
}
