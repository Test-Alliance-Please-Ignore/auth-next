{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "donations",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"vars": {},
	"durable_objects": {
		"bindings": [
			{
				"name": "DONATIONS",
				"class_name": "Donations"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Donations"]
		}
	]
}
