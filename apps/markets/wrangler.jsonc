{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "markets",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		"api.pleaseignore.app/v1/markets/*"
	],
	"logpush": false,
	"observability": {
		"enabled": true
	},
	"vars": {
		// Maximum number of snapshots to retain per location (default: 168 = 1 week of hourly snapshots)
		"MAX_SNAPSHOTS_PER_LOCATION": 168
	},
	"services": [
		{
			"binding": "EVE_STATIC_DATA",
			"service": "eve-static-data"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MARKETS",
				"class_name": "Markets"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Markets"]
		}
	]
}
