{
	"name": "ui",
	"version": "0.2.4",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"deploy": "pnpm build && run-wrangler-deploy",
		"dev": "run-vite-dev",
		"dev:client": "vite dev --config vite.client.config.ts",
		"dev:wrangler": "pnpm build && wrangler dev",
		"dev:wrangler:local": "bun run build && run-wrangler-dev-local",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest",
		"test:focused": "run-vitest --config vitest.unit.config.ts",
		"test:unit": "run-vitest --config vitest.unit.config.ts"
	},
	"dependencies": {
		"@fingerprintjs/fingerprintjs": "5.0.1",
