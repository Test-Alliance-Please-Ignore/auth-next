{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-token-store",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": ["pleaseignore.app/evesso/*"],
	"logpush": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "ESI_RATE_LIMITS",
			"id": "40ba8cdb7cb14b8e9bbed35f34faf27b"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveTokenStore"]
		}
	]
}
