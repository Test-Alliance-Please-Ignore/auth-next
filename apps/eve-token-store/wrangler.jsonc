{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-token-store",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": ["pleaseignore.app/evesso/*"],
	"logpush": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"vars": {},
	"analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "nuauth_analytics" }],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveTokenStore"]
		}
	]
}
