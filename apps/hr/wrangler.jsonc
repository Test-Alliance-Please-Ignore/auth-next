{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hr",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"queues": {
		"consumers": [{ "queue": "hr-member-departed", "max_batch_size": 100, "max_batch_timeout": 5 }]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "HR",
				"class_name": "Hr"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "GROUPS",
				"class_name": "Groups",
				"script_name": "groups"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Hr"]
		}
	]
}
