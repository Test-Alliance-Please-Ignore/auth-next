{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fleets",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "ESI_RATE_LIMITS",
			"id": "40ba8cdb7cb14b8e9bbed35f34faf27b"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "FLEETS",
				"class_name": "Fleets"
			},
			{
				"name": "FLEET_MONITOR",
				"class_name": "FleetMonitor"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Fleets"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FleetMonitor"]
		}
	]
}
