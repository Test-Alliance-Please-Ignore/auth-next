{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-static-data",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"NAME": "eve-static-data",
		"ENVIRONMENT": "production",
		"SENTRY_RELEASE": "unknown"
	},
	"kv_namespaces": [
		{
			"binding": "EVE_SDE_CACHE",
			"id": "5369184146b848bba0c69b768c84a22d"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveStructure"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["EveStructure"]
		}
	]
}
