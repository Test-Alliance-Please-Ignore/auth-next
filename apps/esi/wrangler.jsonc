{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "esi",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"vars": {},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "ESI_GLOBAL_CACHE",
			"id": "cd0f385dd4d6458c80dea2108d51a8f7"
		},
		{
			"binding": "ESI_RATE_LIMITS",
			"id": "40ba8cdb7cb14b8e9bbed35f34faf27b"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Esi"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["EsiTypeResolver"]
		}
	]
}
