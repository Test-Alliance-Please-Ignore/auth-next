{
	"name": "esi",
	"version": "0.1.0",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "run-vite-build",
		"check:lint": "run-eslint",
		"check:types": "run-tsc",
		"db:generate": "drizzle-kit generate --config drizzle-sqlite.config.ts && drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "tsx ./src/scripts/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"deploy": "run-wrangler-deploy",
		"dev": "run-vite-dev",
		"fix:workers-types": "run-wrangler-types",
		"preview": "run-vite-preview",
		"tail": "run-wrangler-tail",
		"test": "run-vitest",
		"test:unit": "run-vitest --config vitest.unit.config.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.0.2",
		"@repo/db-utils": "workspace:*",
		"@repo/do-utils": "workspace:*",
		"@repo/esi": "workspace:*",
		"@repo/esi-rate-limit": "workspace:*",
		"@repo/eve-corporation-data": "workspace:*",
		"@repo/eve-token-store": "workspace:*",
		"@repo/fetch-utils": "workspace:*",
		"@repo/hono-helpers": "workspace:*",
		"@repo/universe": "workspace:*",
		"@repo/vite-config": "workspace:*",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.27",
		"workers-tagged-logger": "0.13.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.47.0",
		"@cloudflare/vitest-pool-workers": "0.18.8",
		"@repo/eslint-config": "workspace:*",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "24.10.1",
		"dotenv": "17.2.3",
		"drizzle-kit": "0.31.10",
		"jsonc-parser": "3.3.1",
		"tsx": "4.21.0",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"wrangler": "4.114.0"
	}
}
