{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bills",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "BILLS",
				"class_name": "Bills",
				"script_name": "bills"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			},
			{
				"name": "CORPORATION_TAX",
				"class_name": "CorporationTax",
				"script_name": "corporation-tax"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "DISCORD",
				"class_name": "Discord",
				"script_name": "discord"
			},
			{
				"name": "GROUPS",
				"class_name": "Groups",
				"script_name": "groups"
			}
		]
	},
	"services": [
		{
			"binding": "CORE",
			"service": "core",
			"entrypoint": "CoreWorker"
		}
	],
	"workflows": [
		{
			"name": "bill-schedule-executor",
			"binding": "BILLS_SCHEDULE_EXECUTOR",
			"class_name": "BillScheduleExecutorWorkflow"
		},
		{
			"name": "bill-payment-status-check",
			"binding": "BILL_PAYMENT_STATUS_CHECK",
			"class_name": "BillPaymentStatusCheckWorkflow"
		},
		{
			"name": "bill-discord-notify",
			"binding": "BILL_DISCORD_NOTIFY",
			"class_name": "BillDiscordNotifyWorkflow"
		}
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bills"] }]
}
