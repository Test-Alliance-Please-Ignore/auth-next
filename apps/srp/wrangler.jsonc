{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "srp",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	"vars": {},
	"durable_objects": {
		"bindings": [
			{
				"name": "SRP",
				"class_name": "Srp"
			},
			{
				"name": "MARKETS",
				"class_name": "Markets",
				"script_name": "markets"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "DISCORD",
				"class_name": "Discord",
				"script_name": "discord"
			}
		]
	},
	"workflows": [
		{
			"name": "srp-payment-status-check",
			"binding": "SRP_PAYMENT_STATUS_CHECK",
			"class_name": "SrpPaymentStatusCheckWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Srp"]
		}
	]
}
