{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "srp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [],
	"logpush": false,
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"triggers": {
		"crons": ["15,45 * * * *"]
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "ESI_GLOBAL_CACHE",
			"id": "cd0f385dd4d6458c80dea2108d51a8f7"
		},
		{
			"binding": "ESI_RATE_LIMITS",
			"id": "40ba8cdb7cb14b8e9bbed35f34faf27b"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SRP",
				"class_name": "Srp"
			},
			{
				"name": "SRP_RECENT_LOSS_REFRESH_COORDINATOR",
				"class_name": "RecentLossRefreshCoordinatorDO"
			},
			{
				"name": "MARKETS",
				"class_name": "Markets",
				"script_name": "markets"
			},
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData",
				"script_name": "eve-character-data"
			},
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData",
				"script_name": "eve-corporation-data"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "DISCORD",
				"class_name": "Discord",
				"script_name": "discord"
			}
		]
	},
	"workflows": [
		{
			"name": "srp-payment-status-check",
			"binding": "SRP_PAYMENT_STATUS_CHECK",
			"class_name": "SrpPaymentStatusCheckWorkflow"
		},
		{
			"name": "srp-recent-loss-refresh",
			"binding": "SRP_RECENT_LOSS_REFRESH_WORKFLOW",
			"class_name": "SrpRecentLossRefreshWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Srp"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["RecentLossRefreshCoordinatorDO"]
		}
	]
}
