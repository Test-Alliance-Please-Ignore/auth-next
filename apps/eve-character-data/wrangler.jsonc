{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-character-data",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": ["0 13 * * *"]
	},
	"vars": {},
	"services": [
		{
			"binding": "CORE",
			"service": "core",
			"entrypoint": "CoreWorker"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_CHARACTER_DATA",
				"class_name": "EveCharacterData"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
		]
	},
	"workflows": [
		{
			"name": "eve-character-sync",
			"binding": "EVE_CHARACTER_SYNC",
			"class_name": "EveCharacterSyncWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveCharacterData"]
		}
	]
}
