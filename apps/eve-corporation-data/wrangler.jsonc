{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-corporation-data",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "1481857a8a864e68bbed5d684badb346",
			"remote": false
		}
	],
	"queues": {
		"producers": [{ "queue": "hr-member-departed", "binding": "hr-member-departed" }]
	},
	"services": [
		{
			"binding": "CORE",
			"service": "core",
			"entrypoint": "CoreWorker"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData"
			},
			{
				"name": "CORPORATION_TAX",
				"class_name": "CorporationTax",
				"script_name": "corporation-tax"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "UNIVERSE",
				"class_name": "Universe",
				"script_name": "universe"
			},
			{
				"name": "ESI",
				"class_name": "Esi",
				"script_name": "esi"
			},
			{
				"name": "ESI_TYPE_RESOLVER",
				"class_name": "EsiTypeResolver",
				"script_name": "esi"
			}
		]
	},
	"workflows": [
		{
			"name": "eve-corporation-sync",
			"binding": "EVE_CORPORATION_SYNC",
			"class_name": "EveCorporationSyncWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveCorporationData"]
		}
	]
}
