{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eve-corporation-data",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [],
	"logpush": false,
	"observability": {
		"enabled": true
	},
	"limits": {
		"cpu_ms": 300000
	},
	"vars": {},
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "ab5cf334a1294610896c1a732dcde577"
		}
	],
	"queues": {
		"producers": [{ "queue": "hr-member-departed", "binding": "hr-member-departed" }]
	},
	"services": [
		{
			"binding": "CORE",
			"service": "core",
			"entrypoint": "CoreWorker"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVE_CORPORATION_DATA",
				"class_name": "EveCorporationData"
			},
			{
				"name": "EVE_TOKEN_STORE",
				"class_name": "EveTokenStore",
				"script_name": "eve-token-store"
			},
			{
				"name": "ORCHESTRATOR_WORKFLOW_INSTANCE_MANAGER",
				"class_name": "WorkflowInstanceManager",
				"script_name": "orchestrator"
			}
		]
	},
	"workflows": [
		{
			"name": "eve-corporation-sync",
			"binding": "EVE_CORPORATION_SYNC",
			"class_name": "EveCorporationSyncWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["EveCorporationData"]
		}
	]
}
