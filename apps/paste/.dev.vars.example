# Paste worker local development bindings for wrangler dev
# Copy to .dev.vars and fill values as needed.

# Runtime environment for local behavior toggles
ENVIRONMENT=development
NAME=paste
SENTRY_RELEASE=local-dev
SENTRY_DSN=

# Required for DB-backed metadata/settings
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
